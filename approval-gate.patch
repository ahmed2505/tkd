+.pm-actions .btn:disabled{opacity:.55;cursor:wait}
+.tab .bdg{display:inline-block;min-width:18px;background:var(--bad);color:#fff;border-radius:999px;font-size:11px;font-weight:800;line-height:18px;padding:0 5px;margin-inline-start:4px}
